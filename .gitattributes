# Default: normaliza texto a LF
* text=auto eol=lf

# Scripts Windows
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Code/data (LF)
*.py  text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.zip binary
*.ttf binary
*.otf binary
