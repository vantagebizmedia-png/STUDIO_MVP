# ============================================================
# STUDIO_MVP - .gitattributes (deterministic baseline)
# ============================================================

# Default: normalize text to LF in repo
* text=auto eol=lf

# PowerShell scripts
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf

# Python / JSON / MD / TXT / YAML
*.py  text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Batch / Cmd (si existen)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png  -text
*.jpg  -text
*.jpeg -text
*.gif  -text
*.webp -text
*.mp4  -text
*.wav  -text
*.mp3  -text
*.zip  -text

# Fonts
*.ttf  -text
*.otf  -text
