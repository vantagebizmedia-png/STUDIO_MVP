{
  "voice": {
    "mode": "DRY",
    "active_provider": "demo_tts",
    "default_params": {
      "format": "wav"
    },
    "cache": {
      "dir": "workspace/cache/voice",
      "policy": "prefer",
      "replay_strict": true,
      "salt": ""
    }
  },
  "image": {
    "mode": "DRY",
    "active_provider": "demo_img",
    "default_params": {},
    "cache": {
      "dir": "workspace/cache/images",
      "policy": "prefer",
      "replay_strict": true,
      "salt": ""
    }
  },
  "providers": {
    "demo_tts": {
      "type": "http_binary",
      "url": "http://127.0.0.1/dry_tts",
      "method": "POST",
      "timeout_s": 5,
      "model": "none",
      "headers": {},
      "body": {},
      "fingerprint_fields": [
        "type",
        "url",
        "model"
      ]
    },
    "demo_img": {
      "type": "http_json",
      "url": "http://127.0.0.1/dry_img",
      "method": "POST",
      "timeout_s": 5,
      "model": "none",
      "headers": {},
      "body": {},
      "extract_paths": [
        "data.0.b64_json"
      ],
      "fingerprint_fields": [
        "type",
        "url",
        "model"
      ]
    }
  }
}