# STUDIO_FORCE_MAXSCENES_999_V1

$py = Resolve-PythonExe -RepoRoot $repo

$repo = (Resolve-Path ".").Path

. "$PSScriptRoot\resolve_python.ps1"
param(
  [Parameter(Mandatory=$true)][ValidateNotNullOrEmpty()][string] $PackDir,
  # FFmpeg tuning (opcionales)
  [int] $Crf = 0,
  [string] $X264Preset = "",
  [string] $PixFmt = "",
  [switch] $Faststart,

  [int] $Seed = 21,
  [int] $MaxScenes = 4,

  [ValidateSet("A","B","C","D")]
  [string] $Preset = "B",

  [ValidateSet("FAST","CINE")]
  [string] $Mode = "CINE",

  [ValidateSet("off","fixed","random","topic","menu")]
  [string] $MusicMode = "off",

  [string] $Music = "",
  [double] $MusicVolume = 0.22,
  [double] $Ducking     = 0.70,

  [ValidateSet("fixed","dynamic")]
  [string] $DuckingMode = "dynamic",
  # Post processing (FFmpeg): burn subs + enhance img + master audio
  [switch] $PostPro,
  [switch] $PostProSubs,
  [switch] $PostProImg,
  [switch] $PostProAudio,
  [int]    $PostProCrf = 24,
  [ValidateSet("ultrafast","superfast","veryfast","faster","fast","medium","slow","slower","veryslow")]
  [string] $PostProPreset = "veryfast",
  [switch] $PostProDenoise,
  [string] $PostProDenoiseFilter = "afftdn",
  # Edit (post): trim/fades/gain/text/watermark
  [switch] $Edit,
  [string] $EditOutVideo = "",

  [double] $EditTrimStartSec = 0.0,
  [double] $EditTrimEndSec   = 0.0,

  [double] $EditSpeed = 1.0,
  [double] $EditFadeInSec  = 0.0,
  [double] $EditFadeOutSec = 0.0,

  [double] $EditGainDb = 0.0,
  [switch] $EditLoudnorm,

  [string] $EditText = "",
  [ValidateSet("top","center","bottom")]
  [string] $EditTextPos = "bottom",
  [int] $EditTextSize = 44,
  [int] $EditTextMarginV = 80,
  [string] $EditTextColor = "white",
  [int] $EditTextBox = 1,
  [string] $EditTextBoxColor = "black@0.35",
  [string] $EditFont = "Arial",
  [string] $EditFontFile = "",

  [string] $EditWatermark = "",
  [int] $EditWmW = 220,
  [int] $EditWmMargin = 40,
  [ValidateSet("tl","tr","bl","br")]
  [string] $EditWmPos = "tr",

  [int] $EditCrf = 24,
  [ValidateSet("ultrafast","superfast","veryfast","faster","fast","medium","slow","slower","veryslow")]
  [string] $EditPreset = "veryfast"
)

Set-StrictMode -Version Latest
$ErrorActionPreference="Stop"
# STUDIO_FIX_MAXSCENES_V1: ensure --max_scenes always has a value (avoid argparse error)
$__sbCount = $null
try {
  $sbPath = Join-Path $PackDir "storyboard.json"
  if (Test-Path -LiteralPath $sbPath) {
    $sbRaw = Get-Content -LiteralPath $sbPath -Raw -ErrorAction Stop
    $sbObj = $sbRaw | ConvertFrom-Json
    $__sbCount = @($sbObj).Count
  }
} catch { $__sbCount = $null }

$__ms = $__sbCount
if (-not $__ms -or $__ms -lt 1) { $__ms = 999 }

foreach ($n in @("MaxScenes","maxScenes","max_scenes")) {
  $gv = Get-Variable -Name $n -ErrorAction SilentlyContinue
  $cur = if ($gv) { $gv.Value } else { $null }
  if ($cur -eq $null -or [string]::IsNullOrWhiteSpace("$cur")) {
    Set-Variable -Name $n -Value $__ms -Scope Script -Force
  }
}
chcp 65001 | Out-Null
[Console]::OutputEncoding = [Text.UTF8Encoding]::new($false)
$OutputEncoding = [Text.UTF8Encoding]::new($false)

$Repo = Split-Path $PSScriptRoot -Parent
$Ws = $env:STUDIO_WORKSPACE
if (-not $Ws) { throw "STUDIO_WORKSPACE no esta seteado. Corre: .\studio.ps1 doctor" }
if (-not [IO.Path]::IsPathRooted($Ws)) { throw "STUDIO_WORKSPACE debe ser absoluto: $Ws" }
$WsRoot = $Ws
$OutDir = Join-Path $WsRoot "output"
New-Item -ItemType Directory -Force $OutDir | Out-Null


# Validar PackDir (NO placeholder)
if (!(Test-Path $PackDir -PathType Container)) {
  throw "PackDir no existe o no es directorio: $PackDir  (usa una ruta real tipo ...\runs\<RunId>\content_pack)"
}
$PackDir = (Resolve-Path $PackDir).Path

$presets = @{
  "A" = @("--motion","slow_zoom_in","--motion_strength","0.10","--jitter_px","1.6","--jitter_hz","0.9","--grain_amount","0.016","--vignette","0.14")
  "B" = @("--motion","pan_up","--motion_strength","0.10","--jitter_px","2.0","--jitter_hz","0.9","--grain_amount","0.020","--vignette","0.18")
  "C" = @("--motion","slow_zoom_in","--motion_strength","0.08","--jitter_px","1.0","--jitter_hz","0.8","--grain_amount","0.012","--vignette","0.10")
  "D" = @("--motion","pan_right","--motion_strength","0.12","--jitter_px","1.8","--jitter_hz","1.1","--grain_amount","0.018","--vignette","0.16")
}

# DEFAULT_FFMPEG_TUNING
# Si no setea el usuario, ponemos defaults Ãºtiles:
if ($Mode -eq "FAST") {
  if ($Crf -le 0) { $Crf = 28 }
  if (-not $X264Preset) { $X264Preset = "veryfast" }
  if (-not $PixFmt) { $PixFmt = "yuv420p" }
  if (-not $Faststart) { $Faststart = $true }
} else {
  # CINE
  if ($Crf -le 0) { $Crf = 20 }
  if (-not $X264Preset) { $X264Preset = "medium" }
  if (-not $PixFmt) { $PixFmt = "yuv420p" }
  if (-not $Faststart) { $Faststart = $true }
}

$argsList = @($presets[$Preset])

if ($Mode -eq "FAST") {
  for ($i=0; $i -lt $argsList.Count; $i++) {
    if ($argsList[$i] -eq "--grain_amount") { $argsList[$i+1] = "0.0" }
    if ($argsList[$i] -eq "--vignette")     { $argsList[$i+1] = "0.0" }
  }
}

$Musicargs = @("--music_mode","off")
if ($MusicMode -ne "off") {
  $Musicargs = @(
    "--music_mode",$MusicMode,
    "--music_volume",[string]$MusicVolume,
    "--ducking",[string]$Ducking,
    "--ducking_mode",$DuckingMode
  )

  if ($MusicMode -eq "fixed") {
    if (-not $Music) {
      $defaultMusic = Join-Path $Repo "music\bg.mp3"
      if (Test-Path $defaultMusic) { $Music = $defaultMusic }
      else { throw "MusicMode=fixed pero no diste -Music y no existe $defaultMusic" }
    }
    $Musicargs += @("--music",$Music)
  }
}

Write-Host ""
# --- FFmpeg tuning passthrough (solo si setea) ---
if ($Crf -gt 0)       { $argsList += @("--crf", [string]$Crf) }
if ($X264Preset)      { $argsList += @("--x264_preset", $X264Preset) }
if ($PixFmt)          { $argsList += @("--pix_fmt", $PixFmt) }
if ($Faststart)       { $argsList += @("--faststart") }
Write-Host "FINAL Mode=$Mode Preset=$Preset MusicMode=$MusicMode DuckingMode=$DuckingMode" -ForegroundColor Cyan
Write-Host "PackDir: $PackDir" -ForegroundColor DarkGray

# Marca de tiempo antes del render
$t0 = Get-Date
# ARGFILTER_V1
# run.py NO soporta flags experimentales (--motion/--grain/--crf/etc). Filtrarlos aquÃ­ evita crash.
$withVal = @('--motion','--motion_strength','--jitter_px','--jitter_hz','--grain_amount','--vignette','--crf','--x264_preset','--pix_fmt')
$noVal   = @('--faststart')

if ($null -ne $argsList) {
  $filtered = @()
  for ($i=0; $i -lt $argsList.Count; $i++) {
    $a = [string]$argsList[$i]
    if ($withVal -contains $a) { $i++; continue }  # salta flag + su valor
    if ($noVal   -contains $a) { continue }        # salta solo el flag
    $filtered += $argsList[$i]
  }
  $argsList = $filtered
}
# /ARGFILTER_V1

python $(Join-Path (Resolve-Path (Join-Path $PSScriptRoot "..")).Path "run.py") "IGNORED" --seed $Seed --max_scenes 999 @argsList
$exit = $LASTEXITCODE
if ($exit -ne 0) { throw "run.py fallÃ³ (exit=$exit). No se copiarÃ¡ ningÃºn output." }

$out = Join-Path $OutDir "video_final_latest.mp4"
if (!(Test-Path $out)) { throw "No encontrÃ© output: $out" }

# Asegurar que se actualizÃ³ en esta corrida (evita copiar renders viejos)
$fi = Get-Item $out
if ($fi.LastWriteTime -lt $t0.AddSeconds(-2)) {
  throw "Output existe pero NO se actualizÃ³ en esta corrida: $out (LastWriteTime=$($fi.LastWriteTime))"
}

$suffix = $Mode
if ($MusicMode -ne "off") { $suffix = $suffix + "_MUSIC_" + $DuckingMode.ToUpper() }

$dst = Join-Path $OutDir ("video_FINAL_" + $suffix + "_" + $Preset + ".mp4")
Copy-Item $out $dst -Force
Write-Host "OK: $dst" -ForegroundColor Green

# CURRENT_VIDEO_V1
$curVid = $dst

# POST_PRO_HOOK_V1
if ($PostPro) {
  $pp = Join-Path $Repo "tools\post_pro.ps1"
  if (!(Test-Path $pp)) { throw "No existe post_pro.ps1: $pp" }

  $inVid = $dst
  $flags = @()
  if ($PostProSubs)  { $flags += "-Subs" }
  if ($PostProImg)   { $flags += "-Img" }
  if ($PostProAudio) { $flags += "-Audio" }

  # Defaults: si PostPro ON y no marcaste nada, prende los 3
  if ($flags.Count -eq 0) { $flags = @("-Subs","-Img","-Audio") }
  # POSTPRO_DENOISE_FLAG_V1
  if ($PostProDenoise) {
    $flags += "-Denoise"
    if ($PostProDenoiseFilter) { $flags += @("-DenoiseFilter", $PostProDenoiseFilter) }
  }

  Write-Host ""
  Write-Host "POST_PRO: aplicando a $inVid" -ForegroundColor Cyan

  pwsh -NoProfile -ExecutionPolicy Bypass -File $pp `
    -PackDir $PackDir -InVideo $inVid `
    @flags `
    -Crf $PostProCrf -Preset $PostProPreset
  # POSTPRO_SET_CURVID_V1
  $proGuess = Join-Path (Split-Path $inVid -Parent) (([IO.Path]::GetFileNameWithoutExtension($inVid)) + "_PRO.mp4")
  if (Test-Path $proGuess) {
    $curVid = $proGuess
    Write-Host ("POST_PRO: output -> {0}" -f $curVid) -ForegroundColor DarkGray
  } else {
    $curVid = $inVid
    Write-Host ("WARN: no encontrÃ© output PRO, sigo con input -> {0}" -f $curVid) -ForegroundColor Yellow
  }
}

# EDIT_HOOK_V1
if ($Edit) {
  $ed = Join-Path $Repo "tools\edit.ps1"
  if (!(Test-Path $ed)) { throw "No existe edit.ps1: $ed" }

  # si no existe curVid por cualquier razÃ³n, cae a $dst
  if (-not (Get-Variable -Name curVid -ErrorAction SilentlyContinue)) { $curVid = $dst }
  $inEdit = $curVid
  if (-not $inEdit) { $inEdit = $dst }

  $eArgs = @()

  if ($EditOutVideo) { $eArgs += @("-OutVideo", $EditOutVideo) }

  # numÃ©ricos (los pasamos siempre)
  $eArgs += @(
    "-TrimStartSec", $EditTrimStartSec,
    "-TrimEndSec",   $EditTrimEndSec,
    "-Speed",        $EditSpeed,
    "-FadeInSec",    $EditFadeInSec,
    "-FadeOutSec",   $EditFadeOutSec,
    "-GainDb",       $EditGainDb,
    "-Crf",          $EditCrf,
    "-Preset",       $EditPreset
  )

  if ($EditLoudnorm) { $eArgs += "-Loudnorm" }

  if ($EditText) {
    $eArgs += @(
      "-Text",        $EditText,
      "-TextPos",     $EditTextPos,
      "-TextSize",    $EditTextSize,
      "-TextMarginV", $EditTextMarginV,
      "-TextColor",   $EditTextColor,
      "-TextBox",     $EditTextBox,
      "-TextBoxColor",$EditTextBoxColor,
      "-Font",        $EditFont
    )
    if ($EditFontFile) { $eArgs += @("-FontFile", $EditFontFile) }
  }

  if ($EditWatermark) {
    $eArgs += @(
      "-Watermark", $EditWatermark,
      "-WmW",       $EditWmW,
      "-WmMargin",  $EditWmMargin,
      "-WmPos",     $EditWmPos
    )
  }

  Write-Host ""
  Write-Host ("EDIT: aplicando a {0}" -f $inEdit) -ForegroundColor Cyan

  pwsh -NoProfile -ExecutionPolicy Bypass -File $ed `
    -InVideo $inEdit `
    @eArgs

  # actualiza curVid al output esperado si existe
  if ($EditOutVideo) {
    $od = Split-Path $EditOutVideo -Parent
    if ($od -and (Test-Path $od)) {
      $guess = (Resolve-Path $od).Path + "\" + (Split-Path $EditOutVideo -Leaf)
      if (Test-Path $guess) { $curVid = $guess }
    }
  } else {
    $dir = Split-Path $inEdit -Parent
    $base = [IO.Path]::GetFileNameWithoutExtension($inEdit)
    $guess = Join-Path $dir ($base + "_EDIT.mp4")
    if (Test-Path $guess) { $curVid = $guess }
  }

  Write-Host ("EDIT: output -> {0}" -f $curVid) -ForegroundColor DarkGray
}

# OUTPUT_LATEST_ALIAS_V1
# Crea workspace/output/video_latest.mp4 apuntando al Ãºltimo output real (curVid si existe)
try {
  $outLatest = Join-Path $OutDir "video_latest.mp4"
  if (-not (Get-Variable -Name curVid -ErrorAction SilentlyContinue)) { $curVid = $dst }
  if ($curVid -and (Test-Path $curVid)) {
    Copy-Item $curVid $outLatest -Force
    Write-Host ("OK: output latest -> {0} (from {1})" -f (Split-Path $outLatest -Leaf), (Split-Path $curVid -Leaf)) -ForegroundColor Green
  } else {
    Write-Host "WARN: no pude crear $OutDir\video_latest.mp4 (curVid/dst no existe)" -ForegroundColor Yellow
  }
} catch {
  Write-Host ("WARN: output latest alias fallÃ³: {0}" -f $_.Exception.Message) -ForegroundColor Yellow
}




