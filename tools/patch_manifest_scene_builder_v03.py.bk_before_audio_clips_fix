# tools/patch_manifest_scene_builder_v03.py
# Patch LIVE manifest -> always reconstruct scenes_v03, resolve images, and now REAL per-scene audio clips.
# Deterministic / replay-safe.

from __future__ import annotations

import os
import sys
import json
import glob
import hashlib
from pathlib import Path
from typing import Any, Dict, List, Optional

# --- ensure repo root in sys.path (so "from studio..." works regardless of cwd) ---
THIS_FILE = Path(__file__).resolve()
REPO_ROOT = THIS_FILE.parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from studio.scene_builder_v03 import split_script_into_scenes  # type: ignore
from studio.stock_query import resolve_image_for_scene         # type: ignore
from studio.audio_clip_v03 import clip_wav_segment, safe_copy_master_as_clip  # type: ignore


def _read_json(path: Path) -> Dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def _write_json(path: Path, obj: Dict[str, Any]) -> None:
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")


def _sha1(s: str) -> str:
    return hashlib.sha1(s.encode("utf-8")).hexdigest()


def _pick_master_wav(pack_dir: Path) -> Optional[Path]:
    artifacts = pack_dir / "artifacts"
    candidates: List[Path] = []
    if artifacts.exists():
        candidates.extend([Path(p) for p in glob.glob(str(artifacts / "*.wav"))])

    if not candidates:
        candidates.extend([Path(p) for p in glob.glob(str(pack_dir / "**" / "*.wav"), recursive=True)])

    if not candidates:
        return None

    candidates.sort(key=lambda p: (p.stat().st_size, str(p)), reverse=True)
    return candidates[0]


def _wav_total_ms(wav_path: Path) -> int:
    import wave
    with wave.open(str(wav_path), "rb") as w:
        fr = w.getframerate()
        n  = w.getnframes()
    if fr <= 0:
        return 0
    return int((n * 1000) // fr)


def _extract_script_text(manifest: Dict[str, Any]) -> str:
    if isinstance(manifest.get("script_text"), str) and manifest["script_text"].strip():
        return manifest["script_text"].strip()

    tg = manifest.get("text_generation")
    if isinstance(tg, dict):
        for k in ("script", "script_text", "storyboard", "script_by_clips"):
            v = tg.get(k)
            if isinstance(v, str) and v.strip():
                return v.strip()

    return ""


def _ensure_assets_dict(scene: Dict[str, Any]) -> Dict[str, Any]:
    a = scene.get("assets")
    if not isinstance(a, dict):
        a = {}
        scene["assets"] = a
    return a


def _make_audio_clips(pack_dir: Path, master_wav: Path, scenes: List[Dict[str, Any]]) -> None:
    artifacts = pack_dir / "artifacts"
    artifacts.mkdir(parents=True, exist_ok=True)

    for i, sc in enumerate(scenes, start=1):
        start_ms = int(sc.get("start_ms", 0) or 0)
        end_ms   = int(sc.get("end_ms", 0) or 0)
        out_path = artifacts / f"audio_s{i:02d}.wav"
        try:
            clip_wav_segment(str(master_wav), str(out_path), start_ms, end_ms)
        except Exception:
            safe_copy_master_as_clip(str(master_wav), str(out_path))


def patch_manifest(pack_dir: str, max_scenes: int = 6) -> Dict[str, Any]:
    pack = Path(pack_dir).resolve()
    manifest_path = pack / "manifest_v03.json"
    if not manifest_path.exists():
        raise FileNotFoundError(f"Missing: {manifest_path}")

    manifest = _read_json(manifest_path)

    script_text = _extract_script_text(manifest)
    master_wav = _pick_master_wav(pack)
    if master_wav is None:
        raise FileNotFoundError(f"No WAV found under pack_dir={pack}")

    total_audio_ms = _wav_total_ms(master_wav)

    scenes_v03 = split_script_into_scenes(script_text, max_scenes=max_scenes)

    n = len(scenes_v03) if scenes_v03 else 0
    if n <= 0:
        scenes_v03 = [{
            "id": "s01",
            "index": 1,
            "text": script_text or "",
            "start_ms": 0,
            "end_ms": total_audio_ms,
        }]
        n = 1

    has_timing = all(("start_ms" in s and "end_ms" in s) for s in scenes_v03)
    if not has_timing:
        chunk = total_audio_ms // n if n > 0 else total_audio_ms
        cur = 0
        for idx, s in enumerate(scenes_v03, start=1):
            s["id"] = s.get("id") or f"s{idx:02d}"
            s["index"] = idx
            s["start_ms"] = cur
            if idx == n:
                s["end_ms"] = total_audio_ms
            else:
                cur2 = cur + chunk
                s["end_ms"] = cur2
                cur = cur2
    else:
        scenes_v03.sort(key=lambda s: int(s.get("index", 0) or 0))
        cur = 0
        for idx, s in enumerate(scenes_v03, start=1):
            s["id"] = s.get("id") or f"s{idx:02d}"
            s["index"] = idx
            st = int(s.get("start_ms", 0) or 0)
            en = int(s.get("end_ms", 0) or 0)
            st = max(st, cur, 0)
            en = max(en, st)
            st = min(st, total_audio_ms)
            en = min(en, total_audio_ms)
            s["start_ms"] = st
            s["end_ms"] = en
            cur = en
        scenes_v03[-1]["end_ms"] = total_audio_ms

    for s in scenes_v03:
        assets = _ensure_assets_dict(s)
        if not assets.get("image"):
            assets["image"] = resolve_image_for_scene(s)

    _make_audio_clips(pack, master_wav, scenes_v03)

    for i, s in enumerate(scenes_v03, start=1):
        assets = _ensure_assets_dict(s)
        assets["audio_clip"] = f"artifacts/audio_s{i:02d}.wav"

    manifest["schema_version"] = "v03"
    manifest["scenes_v03"] = scenes_v03
    manifest["total_audio_ms"] = total_audio_ms

    manifest.setdefault("debug", {})
    if isinstance(manifest["debug"], dict):
        manifest["debug"]["master_wav"] = str(master_wav.relative_to(pack)) if str(master_wav).startswith(str(pack)) else str(master_wav)
        manifest["debug"]["script_sha1"] = _sha1(script_text)
        manifest["debug"]["scenes"] = len(scenes_v03)
        manifest["debug"]["total_audio_ms"] = total_audio_ms

    _write_json(manifest_path, manifest)
    return {
        "ok": True,
        "pack_dir": str(pack),
        "manifest": str(manifest_path),
        "scenes": len(scenes_v03),
        "total_audio_ms": total_audio_ms,
        "master_wav": str(master_wav),
    }


def main() -> None:
    import argparse
    ap = argparse.ArgumentParser()
    ap.add_argument("--pack-dir", required=True)
    ap.add_argument("--max-scenes", type=int, default=6)
    args = ap.parse_args()
    out = patch_manifest(args.pack_dir, max_scenes=args.max_scenes)
    print(json.dumps(out, ensure_ascii=False))


if __name__ == "__main__":
    main()
